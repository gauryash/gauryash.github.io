---
import { cn } from '@/utils'

const { class: className, title } = Astro.props
---

<section class={cn(className, 'flex flex-col gap-y-5 md:flex-row md:gap-y-0')}>
	<div class='flex items-start gap-x-3 md:w-1/3'>
		<div class='mt-1.5 hidden h-4 w-0.5 shrink-0 rounded-full bg-foreground/15 md:block'></div>
		<h2 class='text-xl font-semibold' style='text-wrap: balance'>{title}</h2>
	</div>
	<div class='flex flex-col gap-y-3 md:w-2/3'>
		<slot />
	</div>
</section>
