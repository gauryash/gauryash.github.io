		href: 'https://code.visualstudio.com/',
		iconPath: 'vscode',
		iconBgColour: '#2C2C32'
	},
	{
		name: 'Cursor',
		description: 'AI-first IDE',
		href: 'https://cursor.sh/',
		iconPath: 'simple-icons:cursor',
		iconBgColour: '#000000'
	},
	{
		name: 'GitHub',
		description: 'Version Control',
		href: 'https://github.com/',
		iconPath: 'simple-icons:github',
		iconBgColour: '#181717'
	},
	{
		name: 'Python',
		description: 'Primary Language',
		href: 'https://www.python.org/',
		iconPath: 'simple-icons:python',
		iconBgColour: '#3776AB'
	},
	{
		name: 'Docker',
		description: 'Containerization',
		href: 'https://www.docker.com/',
		iconPath: 'simple-icons:docker',
		iconBgColour: '#2496ED'
	},
	{
		name: 'Jupyter',
		description: 'Data Notebooks',
		href: 'https://jupyter.org/',
		iconPath: 'simple-icons:jupyter',
		iconBgColour: '#F37626'
	},
	{
		name: 'ChatGPT',
		description: 'AI Assistant',
