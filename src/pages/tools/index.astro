---
import PageLayout from '@/layouts/BaseLayout.astro'
import ToolSection from '@/components/ToolSection.astro'
import Button from '@/components/Button.astro'

const LANGUAGES = [
	{
		name: 'Python',
		description: 'Data analysis, scripting, automation',
		href: 'https://www.python.org/',
		iconPath: 'simple-icons:python',
		iconBgColour: '#3776AB'
	},
	{
		name: 'TypeScript',
		description: 'Type-safe JavaScript for web apps',
		href: 'https://www.typescriptlang.org/',
		iconPath: 'simple-icons:typescript',
		iconBgColour: '#3178C6'
	},
	{
		name: 'C++',
		description: 'Low-latency systems and HFT tooling',
		href: 'https://en.cppreference.com/',
		iconPath: 'simple-icons:cplusplus',
		iconBgColour: '#00599C'
	},
	{
		name: 'Go',
		description: 'Concurrent data pipeline services',
		href: 'https://go.dev/',
		iconPath: 'simple-icons:go',
		iconBgColour: '#00ADD8'
	}
]

const FRAMEWORKS = [
	{
		name: 'React',
		description: 'Interactive dashboard UIs',
		href: 'https://react.dev/',
		iconPath: 'simple-icons:react',
		iconBgColour: '#61DAFB'
	},
	{
		name: 'Astro',
		description: 'This site — static content framework',
		href: 'https://astro.build/',
		iconPath: 'simple-icons:astro',
		iconBgColour: '#BC52EE'
	},
	{
		name: 'Tailwind CSS',
		description: 'Utility-first styling',
		href: 'https://tailwindcss.com/',
		iconPath: 'simple-icons:tailwindcss',
		iconBgColour: '#06B6D4'
	},
	{
		name: 'Node.js',
		description: 'JavaScript runtime',
		href: 'https://nodejs.org/',
		iconPath: 'simple-icons:nodedotjs',
		iconBgColour: '#5FA04E'
	}
]

const DEVTOOLS = [
	{
		name: 'VS Code',
		description: 'Primary editor',
		href: 'https://code.visualstudio.com/',
		iconPath: 'vscode',
		iconBgColour: '#2C2C32'
	},
	{
		name: 'Git',
		description: 'Version control',
		href: 'https://git-scm.com/',
		iconPath: 'simple-icons:git',
		iconBgColour: '#F05032'
	},
	{
		name: 'Docker',
		description: 'Containerized deployments',
		href: 'https://www.docker.com/',
		iconPath: 'simple-icons:docker',
		iconBgColour: '#2496ED'
	},
	{
		name: 'Linux',
		description: 'Daily driver OS',
		href: 'https://kernel.org/',
		iconPath: 'simple-icons:linux',
		iconBgColour: '#FCC624'
	},
	{
		name: 'Bash',
		description: 'Shell scripting and automation',
		href: 'https://www.gnu.org/software/bash/',
		iconPath: 'simple-icons:gnubash',
		iconBgColour: '#4EAA25'
	}
]

const DATA = [
	{
		name: 'SQL',
		description: 'Data querying and analysis',
		href: 'https://www.postgresql.org/',
		iconPath: 'simple-icons:postgresql',
		iconBgColour: '#4169E1'
	},
	{
		name: 'Jupyter',
		description: 'Exploratory data analysis',
		href: 'https://jupyter.org/',
		iconPath: 'simple-icons:jupyter',
		iconBgColour: '#F37626'
	},
	{
		name: 'GitHub Actions',
		description: 'CI/CD for this site',
		href: 'https://github.com/features/actions',
		iconPath: 'simple-icons:githubactions',
		iconBgColour: '#2088FF'
	}
]
---

<PageLayout meta={{ title: 'Tools' }}>
	<div class='w-full'>
		<Button title='Back' href='/' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>

		<div class='mt-5 flex w-full flex-col gap-y-10'>
			<div>
				<h1 class='mb-1 text-2xl font-bold' style='text-wrap: balance'>Tools</h1>
				<p>Languages, frameworks, and tools I use across quant engineering and web development</p>
			</div>

			<ToolSection title='Languages' tools={LANGUAGES} />
			<ToolSection title='Frameworks' tools={FRAMEWORKS} />
			<ToolSection title='Dev Tools' tools={DEVTOOLS} />
			<ToolSection title='Data & Infrastructure' tools={DATA} />
		</div>
	</div>
</PageLayout>
