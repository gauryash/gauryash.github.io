---
// Redirect old project detail URLs to the project listing page
// All projects are now fetched live from GitHub

export async function getStaticPaths() {
	// Keep old project slugs alive with redirects
	return [{ params: { slug: 'hft-order-book' } }, { params: { slug: 'quant-trading-strategy' } }]
}
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>Redirecting — Yash Gaur</title>
		<meta http-equiv='refresh' content='0; url=/projects/' />
		<style>
			body {
				font-family: system-ui, sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				margin: 0;
				background: #fafafa;
				color: #333;
			}
		</style>
	</head>
	<body>
		<p>Projects are now listed directly from GitHub. <a href='/projects/'>Go to projects</a></p>
	</body>
</html>
