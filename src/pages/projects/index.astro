---
import PageLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import ContributionGraph from '@/components/ContributionGraph.astro'

const GITHUB_USER = 'gauryash'

interface GitHubRepo {
	name: string
	description: string | null
	html_url: string
	language: string | null
	stargazers_count: number
	forks_count: number
	fork: boolean
	topics: string[]
	updated_at: string
	homepage: string | null
}

const response = await fetch(
	`https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100&type=public`,
	{
		headers: {
			Accept: 'application/vnd.github.v3+json',
			'User-Agent': 'astro-resume-site'
		}
	}
)

const repos: GitHubRepo[] = await response.json()

// Sort: non-forks first, then forks; within each group by last updated
const sortedRepos = repos.sort((a, b) => {
	if (a.fork !== b.fork) return a.fork ? 1 : -1
	return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime()
})

const languageColors: Record<string, string> = {
	Python: '#3572A5',
	Astro: '#FF5A03',
	TypeScript: '#3178C6',
	JavaScript: '#F7DF1E',
	Go: '#00ADD8',
	'C++': '#F34B7D',
	Shell: '#89E051',
	HTML: '#E34F26',
	CSS: '#563D7C',
	Jupyter: '#DA5B0F',
	Rust: '#DEA584',
	Kotlin: '#A97BFF',
	Java: '#B07219',
	Dockerfile: '#384D54',
	Swift: '#F05138',
	Ruby: '#701516',
	R: '#198CE7',
	Solidity: '#AA6746',
	Vue: '#4FC08D',
	Svelte: '#FF3E00'
}
---

<PageLayout meta={{ title: 'Projects' }}>
	<div class='w-full'>
		<Button title='Back' href='/' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>

		<div class='mt-5 flex w-full flex-col gap-y-10'>
			<div>
				<h1 class='mb-1 text-2xl font-bold' style='text-wrap: balance'>Projects</h1>
				<p class='text-muted-foreground'>
					All my public work on GitHub — trading tools, LLM experiments, infrastructure, and more
				</p>
			</div>

			<div class='rounded-2xl border border-border bg-primary-foreground px-5 py-5'>
				<ContributionGraph />
			</div>

			{
				sortedRepos.length === 0 ? (
					<p class='text-center text-muted-foreground'>No public repositories found.</p>
				) : (
					<div class='grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2'>
						{sortedRepos.map((repo) => (
							<a
								href={repo.html_url}
								target='_blank'
								rel='noopener noreferrer'
								class='card-hover flex flex-col gap-y-3 rounded-2xl border border-border bg-primary-foreground px-5 py-5 hover:border-foreground/25 hover:shadow-sm'
							>
								<div class='flex items-start justify-between gap-x-3'>
									<div class='flex min-w-0 flex-col gap-y-1.5'>
										<div class='flex items-center gap-x-2'>
											<h2 class='truncate text-lg font-medium'>{repo.name}</h2>
											{repo.fork && (
												<span class='inline-flex shrink-0 items-center rounded-full border border-border/60 bg-muted/30 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-muted-foreground'>
													Fork
												</span>
											)}
										</div>
										{repo.description && (
											<p
												class='line-clamp-2 text-sm text-muted-foreground'
												style='text-wrap: pretty'
											>
												{repo.description}
											</p>
										)}
									</div>
									<svg
										xmlns='http://www.w3.org/2000/svg'
										width='14'
										height='14'
										viewBox='0 0 24 24'
										class='mt-1 shrink-0 text-muted-foreground'
									>
										<path
											fill='currentColor'
											d='M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3zm1 16v-5h-2v5H5V8h5V6H5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h9c1.1 0 2-.9 2-2'
										/>
									</svg>
								</div>

								<div class='mt-auto flex flex-wrap items-center gap-x-4 gap-y-2'>
									{repo.language && (
										<span class='inline-flex items-center gap-x-1.5 text-xs text-muted-foreground'>
											<span
												class='inline-block h-2.5 w-2.5 rounded-full'
												style={`background-color: ${languageColors[repo.language] || '#6b7280'}`}
											/>
											{repo.language}
										</span>
									)}
									{repo.stargazers_count > 0 && (
										<span class='inline-flex items-center gap-x-1 text-xs text-muted-foreground'>
											<svg
												xmlns='http://www.w3.org/2000/svg'
												width='14'
												height='14'
												viewBox='0 0 24 24'
												fill='currentColor'
												class='text-amber-500'
											>
												<path d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z' />
											</svg>
											{repo.stargazers_count}
										</span>
									)}
									{repo.topics && repo.topics.length > 0 && (
										<div class='flex flex-wrap gap-x-1.5 gap-y-1'>
											{repo.topics.slice(0, 3).map((topic) => (
												<span class='inline-flex rounded-md border border-border bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground'>
													{topic}
												</span>
											))}
										</div>
									)}
								</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</PageLayout>
